#extend("base"):
#export("body"):
<h1>Book a Lesson</h1>
<p class="lede">Booking and managing your lessons happens through the MSM Student app — download it, register, and you'll be able to request lessons, see pricing and manage your balance all in one place.</p>

<div class="store-badges" style="margin: 24px 0;">
  <span class="store-badge disabled" style="font-size:16px; padding:12px 20px;">App Store — Coming soon</span>
  <a class="store-badge" style="font-size:16px; padding:12px 20px;" href="https://play.google.com/store/apps/details?id=com.michaelmurray.msmstudent">Google Play</a>
</div>

<p>Prefer to speak first? #if(contactPhone):<a href="tel:#(contactPhone)">Call #(contactPhone)</a>#else:Get in touch directly.#endif</p>
#endexport
#endextend
