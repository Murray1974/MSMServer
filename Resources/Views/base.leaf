<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>#(title) — Murray School of Motoring</title>
<meta name="description" content="#(description)">
<meta property="og:title" content="#(title) — Murray School of Motoring">
<meta property="og:description" content="#(description)">
<meta property="og:type" content="website">
<link rel="icon" href="/pass_assets/icon@3x.png">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "DrivingSchool",
  "name": "Murray School of Motoring",
  "image": "https://murrayschoolofmotoring.co.uk/card/photo",
  "url": "https://murrayschoolofmotoring.co.uk",
  "telephone": "#(contactPhone)",
  "priceRange": "#(rate)",
  "areaServed": ["Exeter", "Crediton", "Copplestone", "Bow", "Tiverton"]
}
</script>
<style>
  :root {
    --green: #1a7f3c;
    --green-bg: #e9f9ee;
    --ink: #111111;
    --muted: #666666;
    --border: #eeeeee;
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: var(--ink); background: #fff; }
  a { color: inherit; }
  .wrap { max-width: 920px; margin: 0 auto; padding: 0 20px; }
  header.site {
    position: relative;
    background: linear-gradient(rgba(5,15,5,0.6), rgba(5,15,5,0.6)), url('/brand/header-bg.jpg') center/cover no-repeat;
    border-bottom: 4px solid var(--green);
  }
  header.site .header-inner { display: flex; align-items: center; justify-content: space-between; padding: 14px 0; }
  .brand-logo { height: 110px; width: auto; display: block; }
  .nav-toggle-checkbox { display: none; }
  .nav-toggle-btn { display: none; cursor: pointer; color: #fff; font-size: 28px; line-height: 1; padding: 4px 10px; user-select: none; }
  nav.site { display: flex; flex-wrap: wrap; }
  nav.site a { color: #eee; text-decoration: none; font-size: 14px; font-weight: 600; margin-left: 20px; text-shadow: 0 1px 2px rgba(0,0,0,0.6); }
  nav.site a:first-child { margin-left: 0; }
  nav.site a:hover, nav.site a.active { color: #fff; }
  @media (max-width: 760px) {
    .nav-toggle-btn { display: block; }
    nav.site {
      display: none;
      flex-direction: column;
      width: 100%;
      background: rgba(5,15,5,0.95);
      position: absolute;
      left: 0; top: 100%;
      padding: 6px 20px 18px;
    }
    .nav-toggle-checkbox:checked ~ nav.site { display: flex; }
    nav.site a { margin: 10px 0 0 !important; }
    .brand-logo { height: 80px; }
  }
  .hero-cta { display: inline-block; background: var(--green); color: #fff !important; padding: 12px 22px; border-radius: 12px; font-weight: 700; text-decoration: none; }
  .hero-cta.secondary { background: #111; }
  main { padding: 40px 0 60px; }
  h1 { font-size: 30px; margin: 0 0 12px; }
  h2 { font-size: 22px; margin: 36px 0 14px; }
  p { line-height: 1.6; color: #333; }
  .lede { font-size: 17px; color: var(--muted); }
  .pill { display: inline-block; background: var(--green-bg); color: var(--green); font-weight: 700; padding: 6px 14px; border-radius: 10px; font-size: 14px; }
  footer.site { background: #f6f6f6; border-top: 1px solid var(--border); padding: 30px 0; margin-top: 40px; }
  footer.site .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px; font-size: 13px; color: var(--muted); }
  footer.site a { color: var(--muted); text-decoration: none; margin-right: 14px; }
  footer.site a:hover { color: var(--ink); }
  .store-badges { margin-top: 8px; }
  .store-badge { display: inline-flex; align-items: center; gap: 6px; background: #111; color: #fff; text-decoration: none; font-weight: 600; font-size: 12px; padding: 7px 12px; border-radius: 8px; margin-right: 6px; }
  .store-badge.disabled { background: #e2e2e2; color: #999; pointer-events: none; }
  @media (max-width: 560px) {
    nav.site { gap: 4px 12px; }
    nav.site a { margin-left: 0; }
  }
</style>
</head>
<body>
  <header class="site">
    <div class="wrap header-inner">
      <a href="/"><img class="brand-logo" src="/brand/logo.png" alt="Murray School of Motoring — Learn, Practise, Pass"></a>
      <input type="checkbox" id="navToggle" class="nav-toggle-checkbox">
      <label for="navToggle" class="nav-toggle-btn" aria-label="Menu">&#9776;</label>
      <nav class="site">
        <a href="/">Home</a>
        <a href="/lessons-pricing">Lessons &amp; Pricing</a>
        <a href="/about">About</a>
        <a href="/areas-covered">Areas Covered</a>
        <a href="/reviews">Reviews</a>
        <a href="/faq">FAQ</a>
        <a href="/book">Book a Lesson</a>
      </nav>
    </div>
  </header>

  <main>
    <div class="wrap">
      #import("body")
    </div>
  </main>

  <footer class="site">
    <div class="wrap">
      <div>
        <div><a href="/card">Digital Business Card</a><a href="/privacy-policy">Privacy Policy</a><a href="/account-deletion">Account Deletion</a></div>
        <div style="margin-top:10px;">&copy; #(currentYear) Murray School of Motoring</div>
      </div>
      <div>
        <div class="store-badges">
          <span class="store-badge disabled">App Store — Coming soon</span>
          <a class="store-badge" href="https://play.google.com/store/apps/details?id=com.michaelmurray.msmstudent">Google Play</a>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
